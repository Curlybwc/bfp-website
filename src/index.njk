---
layout: layouts/base.njk
title: Homes for rent
permalink: /
listingPages: true
---
{% import "components/card.njk" as cards %}
<div class="wrap page">
  <h1>Homes for rent</h1>
  <p class="lede">Section 8 welcome — all our homes accept Housing Choice Vouchers.</p>

  <script type="application/json" id="listings-manifest">{{ listingsManifest | dump | safe }}</script>

  {% if listingsManifest.listings.length %}
  <div class="listing-grid" data-listing-grid data-limit="6"></div>
  <p data-listing-note>Loading our homes…</p>
  <section class="past-rentals" data-past-section hidden aria-labelledby="past-h-home">
    <h2 id="past-h-home">Past Rentals</h2>
    <p>These homes are rented and not available right now.</p>
    <div class="listing-grid" data-listing-grid-past></div>
  </section>
  {% else %}
  <div data-sample-block>
    <div class="listing-grid">
      {% for home in sampleHomes %}
      {{ cards.card(home) }}
      {% endfor %}
    </div>
    <p class="sample-notice">Sample cards — the real homes appear here when the listings publish.</p>
  </div>
  {% endif %}

  <p><a class="btn btn-primary" href="{{ '/find-a-home/' | url }}">See all our homes →</a></p>

  <section class="section" aria-labelledby="steps-h">
    <h2 id="steps-h">How renting a home works</h2>
    <div class="steps-grid">
      <div class="step-card">
        <p class="step-num">1</p>
        <h3>Apply first</h3>
        <p>The application and screening are free.</p>
      </div>
      <div class="step-card">
        <p class="step-num">2</p>
        <h3>See it in person</h3>
        <p>Showings are in person, after screening. The credit/background check is $32 per adult, charged after screening passes.</p>
      </div>
      <div class="step-card">
        <p class="step-num">3</p>
        <h3>Sign &amp; move in</h3>
        <p>Half the deposit at signing, half at move-in.</p>
      </div>
    </div>
    <p><a class="btn btn-ghost" href="{{ '/how-to-apply/' | url }}">How to Apply &amp; Requirements</a></p>
  </section>

  <section class="family-band" aria-labelledby="family-h">
    <h2 id="family-h">From our family to yours</h2>
    <p>Bahr Family Properties is a local family company — we own the homes we rent.</p>
    <p><a class="btn btn-band" href="{{ '/our-family/' | url }}">Our Family</a></p>
  </section>

  <section class="section" aria-labelledby="sell-h">
    <h2 id="sell-h">Selling your home? We buy houses — in any condition.</h2>
    <p><a class="btn btn-ghost" href="{{ '/sell-your-home/' | url }}">Sell Your Home</a></p>
  </section>

  <ul class="trust-row">
    <li>Local family company</li>
    <li>Homes in St. Louis &amp; St. Charles County</li>
    <li>Every home accepts Housing Choice Vouchers</li>
  </ul>
</div>
